DATABASE_NAME=agentstore-dev
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/?appName=YourApp
# LLM provider (OpenAI-compatible). Fill all three to enable chat on first boot.
# Leave blank to configure the LLM provider in the admin dashboard instead.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
JWT_ACCESS_SECRET=run-openssl-rand-hex-32
JWT_REFRESH_SECRET=run-openssl-rand-hex-32
WEBHOOK_ENCRYPTION_KEY=run-openssl-rand-hex-32
APP_NAME=AgentStore
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=AgentStore
SERVER_HOST=localhost
SERVER_PORT=4290
FRONTEND_URL=http://localhost:4280
VITE_PORT=4280
VITE_API_URL=http://localhost:4290
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:4290/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:4290/api/auth/github/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URL=http://localhost:4290/api/auth/microsoft/callback
RESEND_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# 微信支付 V3 — 不填则不启用
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=https://yourdomain.com/api/billing/wechat/notify
# 支付宝网页支付 — 不填则不启用
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://yourdomain.com/api/billing/alipay/notify
ALIPAY_RETURN_URL=https://yourdomain.com/billing/success
ALIPAY_IS_SANDBOX=true
DATADOG_API_KEY=
DATADOG_SITE=us5.datadoghq.com
DATADOG_HOSTNAME=
