# AgentStore — Docker Compose environment template
# Copy to .env and fill in the required values:
#
#   cp .env.docker.example .env
#
# Then run:  docker compose up -d
# Open:      http://localhost:8080  (browser setup wizard on first boot)

# ─── Required ────────────────────────────────────────────────────────────────

# Database name (Mongo service name is wired automatically in docker-compose.yml)
DATABASE_NAME=agentstore

# JWT secrets — generate with:  openssl rand -hex 32
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_HEX_32
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_HEX_32
WEBHOOK_ENCRYPTION_KEY=REPLACE_WITH_RANDOM_HEX_32

# Public URL of the app (used for OAuth redirects, magic links, etc.)
FRONTEND_URL=http://localhost:8080

# App display name (shown in UI and emails)
APP_NAME=AgentStore

# Sender details for transactional emails
FROM_EMAIL=noreply@yourdomain.com
FROM_NAME=AgentStore

# ─── LLM provider (optional — enables chat on first boot) ────────────────────
# Any OpenAI-compatible endpoint.  Leave blank to configure in the admin UI.
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=

# ─── Email delivery (optional) ───────────────────────────────────────────────
RESEND_API_KEY=

# ─── OAuth providers (optional) ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:8080/api/auth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URL=http://localhost:8080/api/auth/github/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URL=http://localhost:8080/api/auth/microsoft/callback

# ─── Stripe billing (optional) ───────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ─── WeChat Pay V3 (optional) ────────────────────────────────────────────────
WECHAT_PAY_APP_ID=
WECHAT_PAY_MCH_ID=
WECHAT_PAY_API_V3_KEY=
WECHAT_PAY_PRIVATE_KEY=
WECHAT_PAY_CERT_SERIAL_NO=
WECHAT_PAY_NOTIFY_URL=https://yourdomain.com/api/billing/wechat/notify

# ─── Alipay (optional) ───────────────────────────────────────────────────────
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_NOTIFY_URL=https://yourdomain.com/api/billing/alipay/notify
ALIPAY_RETURN_URL=https://yourdomain.com/billing/success
ALIPAY_IS_SANDBOX=true

# ─── DataDog observability (optional) ────────────────────────────────────────
DATADOG_API_KEY=
DATADOG_SITE=us5.datadoghq.com
DATADOG_HOSTNAME=
